# In dev, requests to /api are proxied to the backend (see vite.config.ts) so this
# can stay unset. For a production build served from a different origin than the
# API, set this to the deployed backend URL, e.g. https://api.yourapp.com
# Leave unset for dev (requests go to /api via the Vite proxy).
# Production is set in .env.production -> https://api.getspin.in
# VITE_API_URL=http://localhost:4000

# Supabase → Project Settings → API.
# Both of these are safe to ship in the browser bundle. Never put the
# service_role key here — it bypasses row level security.
VITE_SUPABASE_URL=https://othxcyfakfscrnogixzr.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im90aHhjeWZha2ZzY3Jub2dpeHpyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY4MTIyMzIsImV4cCI6MjEwMjM4ODIzMn0.JzyvZokmouWhU5ZnXUOr1bKFeYt5vpKNhWVaypAzEuA

