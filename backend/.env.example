# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER put real values in this file — it is the
# committed template. .env is gitignored; this one is not.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Supabase → Project Settings → Database → Connection string → "Transaction"
# pooler URI, with the password substituted in.
DATABASE_URL=

# Not used: this project issues ES256 tokens verified against Supabase JWKS.
# SUPABASE_JWT_SECRET=

# Supabase → Project Settings → API. The service-role key bypasses row level
# security: server-only, never in the frontend bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# MSG91 account Authkey. Server-only. Used for exactly one call:
# verifyAccessToken. The Widget ID and Token Auth are public widget config and
# now live in the FRONTEND (.env: VITE_MSG91_WIDGET_ID / VITE_MSG91_TOKEN_AUTH).
MSG91_AUTH_KEY=
# Override only if MSG91 changes its widget host.
# MSG91_BASE_URL=https://control.msg91.com/api/v5/widget

# Derives each Supabase user's password so the server can mint a session after
# MSG91 verifies a phone. Generate with: openssl rand -base64 32
AUTH_PASSWORD_SECRET=

# Supabase cannot enable its Phone provider without one of its supported SMS
# vendors, and MSG91 is not one. Each verified phone therefore gets a
# deterministic address at this domain as its Supabase login identity. No mail
# is ever sent to it.
AUTH_EMAIL_DOMAIN=phone.spin.local

# OTP send/resend/expiry limits are configured on the MSG91 widget itself now,
# not here — the browser owns that lifecycle.

# Comma-separated browser origins allowed to call this API. 5174/5175 are
# Vite's fallbacks when 5173 is already taken. Replace with your real domain in
# production — never use "*" here, these routes mint sessions.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

BUILDING_NAME=GO GREEN HOMES SH-BLOCK
